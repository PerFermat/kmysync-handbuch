# Konfiguration fuer deploy-server.sh
# Kopieren nach "deploy.env" und ausfuellen:   cp deploy.env.example deploy.env
# (deploy.env wird per .gitignore nicht eingecheckt)

# --- Pflicht ---
DEPLOY_HOST="example.com"               # Server-Hostname oder IP
DEPLOY_USER="user"                      # SSH-Benutzer
DEPLOY_PATH="/var/www/kmysync"          # Web-Root der Subdomain (nginx root), muss unter /var/www/ liegen

# --- Optional ---
DEPLOY_PORT="22"                        # SSH-Port
SSH_KEY=""                              # Pfad zum Private Key, z. B. ~/.ssh/id_ed25519 (leer = Standard/Agent)
REMOTE_SUDO="sudo"                      # "" wenn der SSH-User den Web-Root ohne sudo beschreiben darf
REMOTE_OWNER="www-data:www-data"        # Besitzer der Dateien auf dem Server ("" = nicht aendern)
DO_RELOAD="0"                           # 1 = nginx nach dem Kopieren neu laden (fuer reine Inhalte unnoetig)
RELOAD_CMD="systemctl reload nginx"     # Reload-Kommando (wird ggf. mit REMOTE_SUDO davor ausgefuehrt)
SITE_URL="https://kmysync.michaelspahr.de/"
